# Test environment — loaded by the e2e suite only (test/setup-env.ts), which
# applies these with override so a shell variable or .env can never redirect a
# test run at a shared database. The suite refuses to start against any host
# that is not local.
#
# Create a .env.test.local (gitignored) to override any of these locally.

NODE_ENV=test
PORT=4001

# Local Postgres. The e2e global setup creates this database if it is missing
# and applies the committed migrations to it.
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/commerce_os_test

# Dummy secrets — long enough to satisfy the config validation schema. Nothing
# in the suite verifies a real token against them.
CUSTOMER_JWT_SECRET=test_customer_jwt_secret_that_is_at_least_sixty_four_characters_long_0
ADMIN_JWT_SECRET=test_admin_jwt_secret_that_is_at_least_sixty_four_characters_long_00000

# The payment provider is replaced with an in-memory fake in the test app, so
# these are never used to reach Stripe.
STRIPE_SECRET_KEY=sk_test_dummy
STRIPE_WEBHOOK_SECRET=whsec_dummy

# Object storage is never exercised by the suite; these satisfy validation.
STORAGE_BUCKET=test-bucket
STORAGE_ACCOUNT_ID=test-account
STORAGE_ACCESS_KEY_ID=test-key-id
STORAGE_SECRET_ACCESS_KEY=test-secret
STORAGE_PUBLIC_URL=http://localhost:9000/test-bucket

CORS_ORIGINS=http://localhost:3000
