# Environment for the integration suite (`npm run test:e2e`).
#
# Never the hosted database: this suite seeds and deletes rows, and
# `loadTestEnv()` refuses to run against any host that is not local. Global
# setup creates this database if it does not exist and migrates it.
#
# Every secret here is a throwaway. Nothing in this file is a real credential,
# and nothing in it reaches a third party — Stripe and object storage are both
# replaced by in-memory fakes.
#
# Machine-specific credentials belong in `.env.test.local`, which is gitignored
# and loaded after this file, so a developer whose local Postgres wants a
# different user or password overrides DATABASE_URL there rather than here.

NODE_ENV=test

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/commerce_os_test

# 64 characters each, which is all the config schema asks of them.
CUSTOMER_JWT_SECRET=e2e-customer-jwt-secret-not-a-real-key-0000000000000000000000000
ADMIN_JWT_SECRET=e2e-admin-jwt-secret-not-a-real-key-000000000000000000000000000000

STOREFRONT_URL=http://localhost:3000

# Overridden by an in-memory fake in `test/helpers/test-app.ts`.
STRIPE_SECRET_KEY=sk_test_e2e_fake
STRIPE_WEBHOOK_SECRET=whsec_e2e_fake

# Required by the config schema; uploads go to an in-memory fake instead
# (`test/helpers/fake-storage.service.ts`), so nothing here is ever dialled.
STORAGE_BUCKET=e2e-test-bucket
STORAGE_ACCOUNT_ID=e2e-test-account
STORAGE_ACCESS_KEY_ID=e2e-test-key-id
STORAGE_SECRET_ACCESS_KEY=e2e-test-secret
STORAGE_PUBLIC_URL=http://localhost:9000/e2e-test-bucket

CORS_ORIGINS=http://localhost:3000

# Seals ad-platform credentials at rest and signs the note a merchant carries
# to the platform and back. A throwaway, like everything else here. The provider
# itself is an in-memory fake (`test/helpers/fake-ad-platform-provider.ts`), so
# no vendor key is needed and none is set.
AD_PLATFORM_ENCRYPTION_KEY=0a997827f74a1d9e6726633a67d8edc0305498f7eca12e2a3aaeaa1e96b57a51

# Where the callback redirects a merchant back to, asserted by the suite.
ADMIN_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000
