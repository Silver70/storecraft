# Storefront environment — copy this file and fill in the blanks:
#
#     cp .env.example .env
#
# Every `VITE_*` value is compiled into the browser bundle and is public by
# design. Everything else stays on the TanStack Start server and never reaches
# the browser. Never put a secret in a `VITE_` variable.

# ─── Commerce backend (server-only — never exposed to the browser) ───────────

# Base URL of the Commerce OS GraphQL backend, without the /graphql suffix.
COMMERCE_API_URL=http://localhost:4000

# Storefront X-API-Key for this store. Create one in the admin (Settings → API
# Keys); the raw key is shown once, so copy it then.
COMMERCE_API_KEY=

# ─── Stripe (browser-safe publishable key only) ──────────────────────────────

# Stripe publishable key (pk_test_… / pk_live_…) — one storefront deploy is one
# store, so it is a build-time constant; the secret key lives in the backend.
VITE_STRIPE_PUBLISHABLE_KEY=

# ─── Attribution + analytics (browser-visible) ───────────────────────────────

# How long a first touch keeps its claim on an order. Match the backend's
# ATTRIBUTION_LOOKBACK_DAYS — remembering a touch the backend no longer counts
# just sends evidence that never qualifies. Optional; defaults to 30.
VITE_ATTRIBUTION_LOOKBACK_DAYS=30

# Origin serving the drop-in tracker ca.js — usually the commerce backend.
VITE_ANALYTICS_URL=

# Ingest key for ca.js, and the only key that reaches the browser. Give it its
# own API key — never COMMERCE_API_KEY — because a key in the browser is a key
# anyone can create carts with. Leave unset to embed no script; attribution
# capture and checkout work either way.
VITE_ANALYTICS_KEY=

# Autocapture level for ca.js: "none" (default) | "click" | "form" | "all".
VITE_ANALYTICS_AUTOCAPTURE=none

# ─── Set by the runtime, not here ────────────────────────────────────────────

# NODE_ENV is read once, to decide the Secure flag on session cookies. `vite
# dev` and the production server each set it; setting it here overrides them.
